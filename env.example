# fraud-case-companion — environment configuration example.
# Copy to .env and fill in real values. NEVER commit the real .env.
# (Named env.example rather than .env.example so tooling that blocks .env*
#  paths still lets it live in the repo; copy it to .env locally.)

# --- Anti-fraud backend (required) ---
ANTI_FRAUD_BASE_URL=https://anti-fraud.example.internal
# Plaintext agent API key sent as the X-Agent-Api-Key header (never Bearer).
ANTI_FRAUD_AGENT_API_KEY=replace-with-agent-api-key

# --- LLM (required) ---
LLM_API_KEY=replace-with-llm-api-key
# Optional: select the LLM provider builder. Only "gemini" is currently
# registered; an unregistered value raises UnsupportedProviderError.
# LLM_PROVIDER=gemini
# Optional: override the default LLM model.
# LLM_MODEL=gemini-2.5-flash
# Optional: override the default sampling temperature (0-2).
# LLM_TEMPERATURE=0.2
# Optional: override the default max output tokens.
# LLM_MAX_OUTPUT_TOKENS=800

# --- Kafka (required) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=fraud-companion
# Tenant filter: only case.created events for this organization are processed.
KAFKA_ORGANIZATION_ID=replace-with-organization-id
# Optional: outbox topic (default: outbox.events).
# KAFKA_OUTBOX_TOPIC=outbox.events

# --- Delivery / retry (optional) ---
# Max delivery attempts before the on-exhausted action (default: 5).
# KAFKA_MAX_DELIVERY_ATTEMPTS=5
# Backoff seconds between retries, multiplied by attempt number (default: 1.0).
# KAFKA_RETRY_BACKOFF_SECONDS=1.0
# Action when attempts are exhausted: crash | skip (default: crash).
# KAFKA_ON_EXHAUSTED=crash
